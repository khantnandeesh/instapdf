# F23 cloud sources (docs/specs/f23-cloud-pickers.md). All public identifiers, never secrets:
# set them as GitHub Actions *variables* (rule 6), not in git. Leave a provider empty to hide it.

# 1 shows "Choose from Google Drive, Dropbox or OneDrive" and builds the /cloud/<provider> windows.
NEXT_PUBLIC_CLOUD_SOURCES=
# 1 routes every provider to the same-origin /cloud/mock window (CI/e2e). Never set in production.
NEXT_PUBLIC_CLOUD_MOCK=

# Dropbox Chooser app key (App Console; add the site's domains as Chooser domains).
NEXT_PUBLIC_DROPBOX_APP_KEY=
# Google: OAuth 2.0 Web client ID (drive.file) with the authorized redirect URI https://<site>/cloud/google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Microsoft Entra SPA app registration (personal + organizational accounts); redirect URI https://<site>/cloud/onedrive.
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=
